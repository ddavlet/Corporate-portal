# Production-style Compose: use RFC-valid Docker alias (see backend_v2 networks in docker-compose.yml).
BACKEND_WEBHOOK_URL=http://kolberg-django-v2:8001/api/messaging-gateway/webhook/
BACKEND_EVENT_LOG_URL=http://kolberg-django-v2:8001/api/messaging-gateway/events/
DATABASE_URL=postgresql://postgres:postgres@db:5432/tg_gateway
CALLBACK_COOLDOWN_SECS=10
# Telegram user ids (comma-separated) allowed to delete this bot's messages by replying "-".
# Empty = feature off. In production set TG_GATEWAY_OWNER_TELEGRAM_IDS in the root .env.
OWNER_TELEGRAM_IDS=
