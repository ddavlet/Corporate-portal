# Copy this file to production `.env` and adjust domains/paths if needed.
# These variables control Traefik rules for frontend, backend_v2, and root redirect.

# --- FRONTEND ---
# Tenant domains that should serve frontend_v2.
TRAEFIK_FRONTEND_HOST_RULE=Host(`qulay.kolberg.uz`)||Host(`main.kolberg.uz`)||Host(`lemonfit.kolberg.uz`)||Host(`lemonaqua.kolberg.uz`)||Host(`neuron.kolberg.uz`)||Host(`lemonhavo.kolberg.uz`)||Host(`kp.kolberg.uz`)
# Path rule for frontend app routes.
TRAEFIK_FRONTEND_APP_PATH_RULE=PathPrefix(`/app/`)||PathPrefix(`/app`)

# --- BACKEND V2 ---
# Tenant domains for generic backend API router.
TRAEFIK_BACKEND_V2_HOST_RULE=Host(`qulay.kolberg.uz`)||Host(`main.kolberg.uz`)||Host(`lemonfit.kolberg.uz`)||Host(`lemonaqua.kolberg.uz`)||Host(`neuron.kolberg.uz`)||Host(`lemonhavo.kolberg.uz`)||Host(`kp.kolberg.uz`)
# API rule excluding n8n integration and messaging gateway paths.
TRAEFIK_BACKEND_V2_API_PATH_RULE=PathPrefix(`/api`)&& !PathPrefix(`/api/n8n/`)&& !PathPrefix(`/api/messaging-gateway/`)
# Dedicated backend n8n integration rule.
TRAEFIK_BACKEND_V2_N8N_RULE=(Host(`qulay.kolberg.uz`)||Host(`main.kolberg.uz`)||Host(`lemonfit.kolberg.uz`)||Host(`lemonaqua.kolberg.uz`)||Host(`neuron.kolberg.uz`)||Host(`lemonhavo.kolberg.uz`)||Host(`kp.kolberg.uz`))&& PathPrefix(`/api/n8n/`)

# --- DJANGO ---
# Comma-separated list of allowed hostnames for Django (ALLOWED_HOSTS setting).
DJANGO_ALLOWED_HOSTS=main.kolberg.uz,lemonfit.kolberg.uz,lemonfit2.kolberg.uz,neuron.kolberg.uz,lemonaqua.kolberg.uz,qulay.kolberg.uz,lemonhavo.kolberg.uz,kp.kolberg.uz

# Shared portal host (one address for all companies, company from the X-Tenant header).
# Empty = mode off, tenants are resolved by subdomain only. Added to ALLOWED_HOSTS automatically.
PORTAL_SHARED_HOST=
# Host for the Traefik routers of the shared portal (frontend /app and /, backend /api, /static,
# messaging-gateway chats and bot-setup). Kept separate from PORTAL_SHARED_HOST so rolling back the
# backend does not change routing. Needs DNS to this server. Do NOT add this host to TRAEFIK_*_HOST_RULE
# or TRAEFIK_BACKEND_V2_N8N_RULE: n8n, /mcp and messaging-gateway webhook must not answer on it.
# Root redirect to /app works only for *.kolberg.uz hosts.
PORTAL_SHARED_HOST_ROUTER=app.kolberg.uz

# --- MCP (Kolberg Data Server) ---
# Served on every tenant host at https://<subdomain>.kolberg.uz/mcp (Traefik router
# django-v2-tenant-mcp in docker-compose.yml). MCP_HTTP_ENABLED is hardcoded on the
# backend_v2 service; per-company switch is Tenant.mcp_enabled. See docs/MCP_SERVER.md.

# --- AI assistant (Telegram bot -> Claude over the portal MCP) ---
# Console API key for the Telegram AI assistant (backend_v2). Empty = the assistant cannot answer.
ANTHROPIC_API_KEY=
# AI_ASSISTANT_MCP_URL (internal MCP address, http://backend_v2:8001/mcp/) is hardcoded on the
# backend_v2 service in docker-compose.yml, like MCP_HTTP_ENABLED.

# --- Postgres MCP Pro (DBA SSE at mcp.kolberg.uz) ---
# Same login for Traefik Basic Auth AND the Postgres read-only role.
POSTGRES_MCP_HOST=mcp.kolberg.uz
POSTGRES_MCP_USER=mcp_readonly
POSTGRES_MCP_PASSWORD=change-me-strong-password
# Generate from the same user/password (bcrypt). On a machine with apache2-utils / httpd-tools:
#   htpasswd -nbB "$POSTGRES_MCP_USER" "$POSTGRES_MCP_PASSWORD"
# Put the result here; in Compose .env, escape each $ as $$.
# Example shape (not a real hash): mcp_readonly:$$2y$$05$$xxxxxxxx
POSTGRES_MCP_HTPASSWD=mcp_readonly:$$2y$$05$$replace-with-real-hash

# CBU RUz exchange rates: cbu.uz answers only Uzbek IPs. While Kolberg runs abroad, fetch through
# the relay on kolberg-tash (kolberg-infra/cbu-relay); its RELAY_TOKEN goes here. Leave both empty to call cbu.uz directly.
CBU_RATES_BASE_URL=
CBU_RATES_TOKEN=

# --- Web Push (VAPID) ---
# Keys for browser push notifications (backend_v2 and backend_cron). All three empty = push off,
# the portal and the notifications screen keep working. Generate once (e.g. `vapid --gen` from py-vapid),
# public key in base64url (uncompressed point), private key in base64url (raw) or PEM; keep the private key secret.
# VAPID_SUBJECT is a contact URI: mailto:<address> or https://<site>.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- TG GATEWAY ---
# Telegram user ids (comma-separated) of portal owners: a reply "-" from them to a bot message
# deletes that message and the "-" (passed to tg-gateway as OWNER_TELEGRAM_IDS). Empty = off.
TG_GATEWAY_OWNER_TELEGRAM_IDS=
