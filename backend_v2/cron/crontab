# Kolberg — scheduled Django management commands (Asia/Tashkent).
# Installed into /etc/cron.d/kolberg by cron/entrypoint.sh (backend_cron container).
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
TZ=Asia/Tashkent
# Container env (DB credentials etc.) written by entrypoint.sh; bash sources it for every job.
BASH_ENV=/etc/kolberg-cron.env

# Monthly auto-request copies (idempotent per day-of-month).
0 8 * * * root cd /app && python manage.py run_auto_requests >> /proc/1/fd/1 2>&1

# Soft-delete draft requests older than DRAFT_RETENTION_DAYS.
15 8 * * * root cd /app && python manage.py purge_expired_draft_requests >> /proc/1/fd/1 2>&1

# Investment payout Telegram reminders.
0 9 * * * root cd /app && python manage.py run_invest_notifications >> /proc/1/fd/1 2>&1

# Cash-withdrawal overdue alerts (each tenant picks its own hour; command filters by it).
0 * * * * root cd /app && python manage.py run_cash_withdrawal_alerts >> /proc/1/fd/1 2>&1

# Archive CBU USD/UZS exchange rate hourly: yesterday finalized, today refreshed, gaps of the last 14 days filled
# (portal lists and reports read rates only from the archive).
5 * * * * root cd /app && python manage.py sync_cbu_exchange_rate --fill-gaps-days 14 >> /proc/1/fd/1 2>&1

# Weekly investor report to tenant Telegram groups (each tenant picks its weekday and hour;
# command filters by them, InvestReportDispatch dedups per tenant/day).
0 * * * * root cd /app && python manage.py run_invest_reports >> /proc/1/fd/1 2>&1

# Kapitalbank statement import: daytime every 10 min on weekdays 06-22, nightly self-heal at 05:00.
*/10 6-21 * * 1-5 root cd /app && python manage.py import_kapitalbank_statements --mode daytime >> /proc/1/fd/1 2>&1
0 22 * * 1-5 root cd /app && python manage.py import_kapitalbank_statements --mode daytime >> /proc/1/fd/1 2>&1
0 5 * * * root cd /app && python manage.py import_kapitalbank_statements --mode nightly >> /proc/1/fd/1 2>&1
